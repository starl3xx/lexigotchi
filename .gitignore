# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# typescript incremental build info
*.tsbuildinfo

# production
/build
/dist

# testing / coverage
/coverage

# generated economy artifacts are committed on purpose (see scripts/derive-economy.ts),
# but local sim scratch output is not:
/sim-output

# misc
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json

# vercel
.vercel

# env
.env
.env*.local

# AnswerChain schedule — the full future jackpot answer preimages (SECRET + irreplaceable;
# see scripts/generate-answer-chain.ts). Never commit.
*.secret.json

# foundry (smart contracts) — build artifacts + vendored deps; run `npm run contracts:setup`
/contracts/out
/contracts/cache
/contracts/broadcast
/contracts/.gas-snapshot
/contracts/lib
# large, regenerable Merkle tree dump (economy.json keeps the root); `npm run derive:contracts`
/contracts/config/dictionary-tree.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# keeper epoch trees (operational state; deterministic, regenerable with --dry)
keeper-output/
