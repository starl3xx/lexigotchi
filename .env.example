# Copy to .env.local and fill in. .env*.local is gitignored — never commit real keys.

# Neynar (https://dev.neynar.com)
# App API key — SERVER-SIDE ONLY. Used for server-side Farcaster/Neynar lookups
# (e.g. verifying a Quick Auth token, resolving an FID). Never prefix with NEXT_PUBLIC_.
NEYNAR_API_KEY=your-neynar-app-api-key

# Neynar client ID — PUBLIC. Shipped to the browser to power Sign In With Neynar
# (the web fallback for players who aren't in a Farcaster client).
NEXT_PUBLIC_NEYNAR_CLIENT_ID=your-neynar-client-id

# Canonical public URL of the deployment, no trailing slash. Used to build the
# mini-app manifest (/.well-known/farcaster.json) and the share-embed image URLs.
# e.g. https://lexigotchi.vercel.app
NEXT_PUBLIC_URL=https://your-domain.example

# Pre-launch campaign. Set to 1 to show the "add the app + share a cast → free 5-letter pack at
# launch" splash INSTEAD of the game at /play. Empty/unset (or anything other than 1) = game is
# live — the safe default. The /admin console is unaffected. Flip to 1 to run the campaign before
# launch; remove it (or set 0) the day you go live.
NEXT_PUBLIC_PRELAUNCH=

# Neon Postgres — the campaign / add-tracking backend (server-side source of truth that replaces
# the client's optimistic localStorage flags). SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
# Use the POOLED (pgbouncer) URL for the app runtime and the UNPOOLED/direct URL for migrations;
# get both from the Neon dashboard. Migrations: `npm run db:generate` then `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Upstash Redis — rate limits the campaign routes (OPTIONAL; they fail OPEN if unset). Provision via
# the Vercel Marketplace (it injects these, sometimes prefixed e.g. lexigotchi_KV_REST_API_*) or at
# upstash.com. The resolver in src/lib/redis.ts accepts KV_REST_API_*, UPSTASH_REDIS_REST_*, or the
# lexigotchi_KV_* prefix. Use the REST URL + REST (write) token. SERVER-SIDE ONLY.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-write-token

# Operator console (/admin) allowlist — comma-separated Farcaster FIDs. In a production
# build with no allowlist the console is LOCKED (fail-closed) — set this to your FID. Locally
# (dev) it's open without sign-in. The real boundary for on-chain actions is the owner's wallet
# signature; the admin only BUILDS transactions (cast commands + Safe batches). See auth.ts.
NEXT_PUBLIC_ADMIN_FIDS=          # e.g. 12345,67890  (Farcaster FIDs)
# Master override: set to 1 to open the console with NO sign-in — even in production and even if
# NEXT_PUBLIC_ADMIN_FIDS is set (the escape hatch if SIWN / Neynar is unavailable). Remove it to
# re-lock. Operations stay plan-only + wallet-gated, but this drops the discoverability barrier.
NEXT_PUBLIC_ADMIN_OPEN=
