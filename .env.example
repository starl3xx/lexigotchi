# Copy to .env.local and fill in. .env*.local is gitignored — never commit real keys.

# Neynar (https://dev.neynar.com)
# App API key — SERVER-SIDE ONLY. Used for server-side Farcaster/Neynar lookups
# (e.g. verifying a Quick Auth token, resolving an FID). Never prefix with NEXT_PUBLIC_.
NEYNAR_API_KEY=your-neynar-app-api-key

# Neynar client ID — PUBLIC. Shipped to the browser to power Sign In With Neynar
# (the web fallback for players who aren't in a Farcaster client).
# NO LONGER USED (Sign In With Neynar retired 2026-08-14; web auth is SIWF now)
# NEXT_PUBLIC_NEYNAR_CLIENT_ID=your-neynar-client-id

# Canonical public URL of the deployment, no trailing slash. Used to build the
# mini-app manifest (/.well-known/farcaster.json) and the share-embed image URLs.
# e.g. https://lexigotchi.vercel.app
NEXT_PUBLIC_URL=https://your-domain.example

# Base App mini-app id — emitted as <meta name="base:app_id"> in the /play head so the Base App
# recognizes the rendered mini app (the Base analogue of the Farcaster accountAssociation). OPTIONAL:
# a working value is baked into src/lib/site.ts; set this only to override it for another environment.
BASE_APP_ID=

# Base Builder Code (base.dev → Settings → Builder Codes) — ERC-8021 attribution suffix appended to
# every on-chain transaction so our txs are credited on Base. PUBLIC (it travels in calldata). OPTIONAL:
# our code is baked into src/lib/onchain/builderCode.ts; set this only to override it for another env.
NEXT_PUBLIC_BASE_BUILDER_CODE=

# Pre-launch campaign. Set to 1 to show the "add the app + share a cast → free 5-letter pack at
# launch" splash INSTEAD of the game at /play. Empty/unset (or anything other than 1) = game is
# live — the safe default. The /admin console is unaffected. Flip to 1 to run the campaign before
# launch; remove it (or set 0) the day you go live.
NEXT_PUBLIC_PRELAUNCH=

# Neon Postgres — the campaign / add-tracking backend (server-side source of truth that replaces
# the client's optimistic localStorage flags). SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
# Use the POOLED (pgbouncer) URL for the app runtime and the UNPOOLED/direct URL for migrations;
# get both from the Neon dashboard. Migrations: `npm run db:generate` then `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Upstash Redis — rate limits the campaign routes (OPTIONAL; they fail OPEN if unset). Provision via
# the Vercel Marketplace (it injects these, sometimes prefixed e.g. lexigotchi_KV_REST_API_*) or at
# upstash.com. The resolver in src/lib/redis.ts accepts KV_REST_API_*, UPSTASH_REDIS_REST_*, or the
# lexigotchi_KV_* prefix. Use the REST URL + REST (write) token. SERVER-SIDE ONLY.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-write-token

# Cron auth — a long random secret. Vercel auto-attaches it as `Authorization: Bearer $CRON_SECRET`
# to scheduled invocations of the jobs in vercel.json; the /api/cron/* routes verify it and FAIL
# CLOSED in production if it's unset. SERVER-SIDE ONLY.
CRON_SECRET=your-long-random-cron-secret

# Operator console (/admin) allowlist — comma-separated Farcaster FIDs. In a production
# build with no allowlist the console is LOCKED (fail-closed) — set this to your FID. Locally
# (dev) it's open without sign-in. The real boundary for on-chain actions is the owner's wallet
# signature; the admin only BUILDS transactions (cast commands + Safe batches). See auth.ts.
# PRIMARY: allowlist the operator's WALLET. Every operation the console builds must be signed by
# the owner key anyway, so this gates on the credential that actually holds the power. Comma-
# separated, any casing (matched case-insensitively).
NEXT_PUBLIC_ADMIN_WALLETS=       # e.g. 0xYourOwnerWallet,0xBackupWallet
# Also accepted: Farcaster FIDs. Useful inside a mini-app host, where an identity arrives with no
# sign-in step. NOTE: on the open web this depended on Sign In With Neynar, which retires
# 2026-08-14 — after that, a FID-only allowlist cannot be satisfied from a normal browser.
NEXT_PUBLIC_ADMIN_FIDS=          # e.g. 12345,67890  (Farcaster FIDs)
# Master override: set to 1 to open the console with NO sign-in — even in production and even if
# NEXT_PUBLIC_ADMIN_FIDS is set (the escape hatch if SIWN / Neynar is unavailable). Remove it to
# re-lock. Operations stay plan-only + wallet-gated, but this drops the discoverability barrier.
NEXT_PUBLIC_ADMIN_OPEN=

# --- on-chain runtime -------------------------------------------------------
# Which network the app targets. Unset = Base mainnet (8453). 84532 = Base Sepolia.
# An unrecognised id throws at BUILD time rather than falling back — see src/lib/onchain/network.ts.
NEXT_PUBLIC_CHAIN_ID=
# Dedicated RPC endpoint. Strongly preferred over the public round-robin ones, whose nodes
# disagree about nonces under load (this cost us nine contracts on the Sepolia rehearsal).
NEXT_PUBLIC_RPC_URL=
# Base MAINNET RPC for Coinbase-attestation reads (the verified-wallet daily). Server-only and
# deliberately separate from NEXT_PUBLIC_RPC_URL: attestations live on mainnet even when the game
# runs on Sepolia. Unset = the public https://mainnet.base.org (fine at low volume).
BASE_MAINNET_RPC_URL=

# --- reveal signer (SERVER ONLY — never NEXT_PUBLIC) ------------------------
# The contracts' `signer` role. This key is the game's MINT AUTHORITY: it can issue unlimited free
# packs and force every roll to succeed. It must match Letters.signer() / Rolls.signer() /
# Prestige.signer() on the target network.
SIGNER_PRIVATE_KEY=
# Seeds the deterministic draw. Outcomes are HMAC(secret, chainId:namespace:commitId), which is what
# makes the reveal endpoints idempotent — a player cannot re-request until they like the letters.
# Changing it re-rolls every UNREVEALED commit, so treat it as permanent once players exist.
SIGNER_DRAW_SECRET=
