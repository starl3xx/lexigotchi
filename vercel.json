{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reconcile-campaign",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notify-daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/keeper",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/telegram-recap",
      "schedule": "20 0,2 * * *"
    },
    {
      "path": "/api/cron/telegram-alerts",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/_mintlify/:path*",
      "destination": "https://lexigotchi.mintlify.site/_mintlify/:path*"
    },
    {
      "source": "/api/request",
      "destination": "https://lexigotchi.mintlify.site/_mintlify/api/request"
    },
    {
      "source": "/docs",
      "destination": "https://lexigotchi.mintlify.site/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://lexigotchi.mintlify.site/docs/:match*"
    },
    {
      "source": "/mintlify-assets/:path+",
      "destination": "https://lexigotchi.mintlify.site/mintlify-assets/:path+"
    }
  ]
}
